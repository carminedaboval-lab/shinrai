const READY_WEAPONS := ["uzi", "shigure", "kite", "raiden_r56", "tobikage", "hayate", "yuzuru", "akane"]

static func weapon(id: String) -> Dictionary:
	var spec: Dictionary = WEAPONS.get(id, {}).duplicate(true)
	if not spec.is_empty():
		spec.ammo_type = str(spec.get("ammo_type", "7.62×51 mm NATO" if id == "kite" else "9×19 mm"))
		spec.closed_bolt = bool(spec.get("closed_bolt", id != "uzi"))
	return spec

static func optic(id: String) -> Dictionary:
	return OPTICS.get(id, {}).duplicate(true)

static func compatible(weapon_id: String, optic_id: String) -> bool:
	if not WEAPONS.has(weapon_id) or not OPTICS.has(optic_id): return false
	var attachment: Dictionary = OPTICS[optic_id]
	# Some assemblies support a subset of the common mounting standard.
	if WEAPONS[weapon_id].has("compatible_optics") and optic_id not in WEAPONS[weapon_id].compatible_optics: return false
	return not str(WEAPONS[weapon_id].optic_mount).is_empty() and WEAPONS[weapon_id].optic_mount == attachment.mount and (not attachment.has("weapons") or weapon_id in attachment.weapons)

static func available(id: String) -> bool:
	# A new gun is enabled only by its reviewed assembled scene, never a proxy.
	return READY_WEAPONS.has(id) and WEAPONS.has(id) and ResourceLoader.exists(WEAPONS[id].scene)

static func effective(id: String, optic_id: String) -> Dictionary:
	var spec := weapon(id)
	if spec.is_empty(): return spec
	# Original gameplay mass estimates. Existing optic ergonomics remain, while
	# total weapon mass adds a modest raising-speed and visual inertia tradeoff.
	# These are neither inventory weight changes nor measured GZW statistics.
	spec.handling_total_mass_kg = float(spec.handling_mass_kg)
	if compatible(id, optic_id):
		var attachment := optic(optic_id)
		spec.ads_fov = attachment.ads_fov
		spec.ads_speed *= attachment.ads_speed_multiplier
		spec.handling_total_mass_kg += float(attachment.handling_mass_kg)
	spec.handling_ads_multiplier = clampf(pow(3.25 / float(spec.handling_total_mass_kg), 0.18), 0.86, 1.06)
	spec.ads_speed *= spec.handling_ads_multiplier
	return spec
