extends RefCounted
## Ground-only finishing. Build after soil/planting, before street batching.
## All coordinates are street metres. No assets, lights, collisions or building edits.
const EDGE_WIDTH := .08
const EDGE_TOP := .088
const EDGE_BOTTOM := .015
const STONE_LENGTH := .60
const JOINT := .004
const GULLY_HOLES: Array[Rect2] = [Rect2(-4.94,239.72,.32,.38),Rect2(2.62,239.72,.32,.38)]
const FINE_WOOD := "res://assets/shinrai/streets/midori_frontage_construction/"
const FineTimber := preload("res://scripts/midori_fine_timber.gd")

static func build(street: Node3D, ground: Node3D, report: Dictionary) -> Dictionary:
	var root := Node3D.new()
	root.name = "CourtGardenDetails"
	root.set_meta("creator_protected",true)
	ground.add_child(root)
	var soils: Array[Rect2] = []
	var paving: Array[Rect2] = []
	soils.assign(report.get("soil_rectangles",[]))
	paving.assign(report.get("paving_rectangles",[]))
	var runs := _union_edges(soils,paving)
	var strips: Array[Rect2] = []
	var stones: Array[Dictionary] = []
	for run: Dictionary in runs:
		var strip := _strip(run)
		# At corners the first strip owns the corner stone. Subtract that area
		# from subsequent strips rather than stacking perpendicular rim meshes.
		var pieces := _subtract(strip,strips)
		for piece: Rect2 in pieces:
			_stones(street,root,piece,int(run.axis),stones)
		strips.append(strip)
	var gullies: Array[Dictionary] = []
	var holes: Array[Rect2] = []
	holes.assign(report.get("drain_holes",[]))
	for index: int in range(GULLY_HOLES.size()):
		var hole := GULLY_HOLES[index]
		if _has_rect(holes,hole):
			gullies.append(_gully(street,root,hole,index))
	var result := {"root":str(root.get_path()),"edge_runs":runs,"edge_strips":strips,
		"edge_stones":stones,"edge_unit_count":stones.size(),"edge_width_m":EDGE_WIDTH,
		"edge_top_y":EDGE_TOP,"edge_bottom_y":EDGE_BOTTOM,"gullies":gullies,
		"gully_count":gullies.size(),"collision_count":0,"lights_created":0,
		"bench_finish":_bench_finish(ground),
		"bench_policy":"existing prop relocated by court ground owner; no new bench",
		"boundary_policy":"soil union against paving union only; no internal soil partitions or duplicate pocket rims"}
	root.set_meta("garden_details",result)
	report["garden_details"] = result
	return result

static func _bench_finish(ground: Node3D) -> Dictionary:
	var bench := ground.get_node_or_null("CourtBenchFacingGallery") as Node3D
	var result := {"meshes_updated":0,"source_material":"BakedMaterial","geometry_unchanged":true,
		"source_uv_unchanged":true,"metal_policy":"retain original neutral atlas pixels and PBR values",
		"wood_grain_axis":"source bench X, physical metres","material":"CourtBench_AtlasPreservingFineTimber"}
	if bench == null: return result
	var pending: Array[Node] = [bench]
	while not pending.is_empty():
		var node: Node = pending.pop_back()
		pending.append_array(node.get_children())
		if not node is MeshInstance3D: continue
		var visual := node as MeshInstance3D
		for surface: int in range(visual.mesh.get_surface_count()):
			var source := visual.get_active_material(surface) as StandardMaterial3D
			# Source GLB inspection confirms one BakedMaterial atlas containing
			# both charcoal metal and warm timber. Never replace the whole atlas
			# with wood based on an autogenerated scene/mesh label.
			if source == null or source.resource_name != "BakedMaterial" or source.albedo_texture == null:
				continue
			var material := ShaderMaterial.new()
			material.resource_name = "CourtBench_AtlasPreservingFineTimber"
			material.shader = preload("res://scripts/midori_court_bench_finish.gdshader")
			material.set_shader_parameter("original_albedo",source.albedo_texture)
			material.set_shader_parameter("source_normal",source.normal_texture)
			material.set_shader_parameter("source_roughness",source.roughness_texture)
			material.set_shader_parameter("source_metallic",source.metallic_texture)
			material.set_shader_parameter("source_color_factor",source.albedo_color)
			material.set_shader_parameter("source_normal_depth",source.normal_scale)
			material.set_shader_parameter("source_roughness_factor",source.roughness)
			material.set_shader_parameter("source_metallic_factor",source.metallic)
			material.set_shader_parameter("source_specular",source.metallic_specular)
			material.set_shader_parameter("timber_grain",_bench_grain_texture())
			material.set_shader_parameter("timber_normal",load(FINE_WOOD+"fine_grained_wood_nor_gl_2k.png"))
			material.set_shader_parameter("timber_roughness_map",load(FINE_WOOD+"fine_grained_wood_rough_2k.jpg"))
			visual.set_meta("court_bench_finish_source_mesh",visual.mesh)
			visual.set_meta("court_bench_finish_source_material",source)
			visual.set_surface_override_material(surface,material)
			result.meshes_updated += 1
	bench.set_meta("court_bench_finish",result)
	return result

static func _bench_grain_texture() -> ImageTexture:
	# This shared source is imported without mipmaps. The bench shader needs
	# a mean-colour LOD, so it samples a local mip pyramid. That pyramid is the
	# one FineTimber already builds from the same file: sharing it avoids a
	# second identical 2048 px decode, mip build and upload.
	return FineTimber.grain()

static func _union_edges(soils: Array[Rect2], paving: Array[Rect2]) -> Array[Dictionary]:
	var all: Array[Rect2] = soils.duplicate()
	all.append_array(paving)
	var xs := _coordinates(all,0)
	var zs := _coordinates(all,1)
	var result: Array[Dictionary] = []
	# Subdivide only at true source-rectangle endpoints, test membership on
	# both sides, then merge adjacent collinear pieces before making stones.
	for z: float in zs:
		var active: Dictionary = {}
		for i: int in range(xs.size()-1):
			var sign_value := _boundary_side(Vector2((xs[i]+xs[i+1])*.5,z),Vector2(0,.001),soils,paving)
			if sign_value == 0 or (not active.is_empty() and int(active.soil_side) != sign_value):
				if not active.is_empty(): result.append(active)
				active = {}
			if sign_value != 0:
				if active.is_empty(): active={"axis":0,"line":z,"start":xs[i],"end":xs[i+1],"soil_side":sign_value}
				else: active["end"] = xs[i+1]
		if not active.is_empty(): result.append(active)
	for x: float in xs:
		var active: Dictionary = {}
		for i: int in range(zs.size()-1):
			var sign_value := _boundary_side(Vector2(x,(zs[i]+zs[i+1])*.5),Vector2(.001,0),soils,paving)
			if sign_value == 0 or (not active.is_empty() and int(active.soil_side) != sign_value):
				if not active.is_empty(): result.append(active)
				active = {}
			if sign_value != 0:
				if active.is_empty(): active={"axis":1,"line":x,"start":zs[i],"end":zs[i+1],"soil_side":sign_value}
				else: active["end"] = zs[i+1]
		if not active.is_empty(): result.append(active)
	return result

static func _coordinates(rectangles: Array[Rect2], axis: int) -> Array[float]:
	var values: Array[float] = []
	for rect: Rect2 in rectangles:
		values.append(rect.position[axis])
		values.append(rect.end[axis])
	values.sort()
	var result: Array[float] = []
	for value: float in values:
		if result.is_empty() or absf(value-result.back()) > .0001:
			result.append(value)
	return result

static func _boundary_side(point: Vector2, epsilon: Vector2, soils: Array[Rect2], paving: Array[Rect2]) -> int:
	var plus := point+epsilon
	var minus := point-epsilon
	if _inside(plus,soils) and not _inside(minus,soils) and _inside(minus,paving): return 1
	if _inside(minus,soils) and not _inside(plus,soils) and _inside(plus,paving): return -1
	return 0

static func _inside(point: Vector2, rectangles: Array[Rect2]) -> bool:
	for rect: Rect2 in rectangles:
		if rect.has_point(point): return true
	return false

static func _strip(run: Dictionary) -> Rect2:
	var inset := 0.0 if int(run.soil_side)>0 else -EDGE_WIDTH
	if int(run.axis)==0:
		return Rect2(float(run.start),float(run.line)+inset,float(run.end)-float(run.start),EDGE_WIDTH)
	return Rect2(float(run.line)+inset,float(run.start),EDGE_WIDTH,float(run.end)-float(run.start))

static func _stones(street: Node3D, root: Node3D, strip: Rect2, axis: int, rows: Array[Dictionary]) -> void:
	var length := strip.size[axis]
	var offset := 0.0
	while offset < length-.004:
		var step := minf(STONE_LENGTH,length-offset)
		if step < .012: break
		var rect := strip
		rect.position[axis] += offset+JOINT*.5
		rect.size[axis] = step-JOINT
		var p := Vector3(rect.get_center().x,(EDGE_TOP+EDGE_BOTTOM)*.5,rect.get_center().y)
		var size := Vector3(rect.size.x,EDGE_TOP-EDGE_BOTTOM,rect.size.y)
		var id := "BedEdgeStone_%04d" % rows.size()
		var member := _part(street,root,id,p,size,"land_curb")
		member.set_meta("garden_edge_stone",true)
		rows.append({"id":id,"rect":rect,"bounds":member.transform*member.get_aabb(),"axis":axis,"joint_m":JOINT})
		offset += step

static func _gully(street: Node3D, parent: Node3D, hole: Rect2, index: int) -> Dictionary:
	var root := Node3D.new()
	root.name = "SugiDownpipeGullyWest" if index==0 else "SugiDownpipeGullyEast"
	parent.add_child(root)
	var rows: Array[Dictionary] = []
	var centre := hole.get_center()
	var opening := hole.grow(-.025)
	# A real shallow tray sits above foundation Y=-.02. Its four walls and
	# slotted lid occupy the soil cutout, never a dark sheet over intact soil.
	_gully_part(street,root,"BasinBottom",Vector3(centre.x,-.013,centre.y),Vector3(hole.size.x,.004,hole.size.y),"land_gutter",rows)
	for side: float in [-1.0,1.0]:
		_gully_part(street,root,"FrameSide_%d" % int(side),Vector3(centre.x+side*(hole.size.x*.5-.0125),.0045,centre.y),Vector3(.025,.031,hole.size.y),"land_iron",rows)
		_gully_part(street,root,"FrameEnd_%d" % int(side),Vector3(centre.x,.0045,centre.y+side*(hole.size.y*.5-.0125)),Vector3(hole.size.x-.05,.031,.025),"land_iron",rows)
	var bars := 6
	for bar: int in range(bars):
		var x := opening.position.x+.024+float(bar)*(opening.size.x-.048)/float(bars-1)
		_gully_part(street,root,"GrateBar_%02d" % bar,Vector3(x,.014,centre.y),Vector3(.012,.008,opening.size.y),"land_iron",rows)
	_gully_part(street,root,"GrateCrossTie",Vector3(centre.x,.0095,centre.y),Vector3(opening.size.x,.005,.012),"land_iron",rows)
	var outlet := Vector3(-4.66 if index==0 else 2.66,.125,239.94)
	var bounds := AABB(Vector3(hole.position.x,-.015,hole.position.y),Vector3(hole.size.x,.035,hole.size.y))
	var result := {"id":str(root.name),"root":str(root.get_path()),"hole":hole,"opening":opening,
		"outer_bounds":bounds,"bottom_y":-.015,"basin_floor_y":-.011,"lip_y":.02,
		"grate_top_y":.018,"outlet":outlet,"members":rows,"foundation_top_y":-.02,
		"fixture_type":"open framed grated receiver with actual soil cutout","collision_count":0}
	root.set_meta("gully_receiver",result)
	return result

static func _gully_part(street: Node3D, root: Node3D, id: String, p: Vector3, size: Vector3, material: String, rows: Array[Dictionary]) -> void:
	var member := _part(street,root,id,p,size,material)
	rows.append({"id":id,"bounds":member.transform*member.get_aabb(),"material":material})

static func _part(street: Node3D, root: Node3D, id: String, p: Vector3, size: Vector3, material: String) -> MeshInstance3D:
	return street.call("_box",root,id,p,size,material,false) as MeshInstance3D

static func _has_rect(rectangles: Array[Rect2], target: Rect2) -> bool:
	for rect: Rect2 in rectangles:
		if rect.position.is_equal_approx(target.position) and rect.size.is_equal_approx(target.size): return true
	return false

static func _subtract(area: Rect2, cuts: Array[Rect2]) -> Array[Rect2]:
	var pieces: Array[Rect2] = [area]
	for cut: Rect2 in cuts:
		var next: Array[Rect2] = []
		for piece: Rect2 in pieces:
			var overlap := piece.intersection(cut)
			if not overlap.has_area():
				next.append(piece)
				continue
			for rect: Rect2 in [Rect2(piece.position,Vector2(piece.size.x,overlap.position.y-piece.position.y)),Rect2(piece.position.x,overlap.end.y,piece.size.x,piece.end.y-overlap.end.y),Rect2(piece.position.x,overlap.position.y,overlap.position.x-piece.position.x,overlap.size.y),Rect2(overlap.end.x,overlap.position.y,piece.end.x-overlap.end.x,overlap.size.y)]:
				if rect.size.x>.001 and rect.size.y>.001: next.append(rect)
		pieces = next
	return pieces
