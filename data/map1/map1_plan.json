  "events": {
    "about": "Things that go off during the 46-minute raid and pull a player's attention, even when nobody is near. Not constant: each is noticed only within its range. Every time and number is a default (owner, 2026-11-13: 'it doesn't have to be a constant encounter but things have to be going off that get the players' attention'). Checked by tools/map_plan/audit_map1.py.",
    "schedule": [
      {"name": "Tram goes round", "where": "loop", "along": true, "minutes": [4, 10, 16, 22, 28, 34, 40, 43], "count": 1, "noticed_m": 150, "what": "A tram runs the loop, rumbling and ringing at every stop: where the way out is, and when. Heard all along the line."},
      {"name": "Robot work starts", "where": "work_sites", "minutes": [5, 11, 17, 24, 30, 36], "count": 1, "noticed_m": 160, "what": "Robots close a street and start repairing: grinding, and welding light on the walls. Interrupt them for robot parts, or go round."},
      {"name": "Scavs and robots fight", "where": "homes", "minutes": [6, 14, 22, 30, 38], "count": 1, "noticed_m": 450, "what": "A scav crew and a robot patrol meet and shoot it out. Gunfire carries 450 m: a fight to avoid, or to arrive at late and loot."},
      {"name": "Robot round passes", "where": "patrols", "along": true, "minutes": [3, 9, 15, 21, 27, 33, 39], "count": 2, "noticed_m": 110, "what": "A patrol group marches along its route: heavy steps in time. Heard along the two routes that are walked at that time."},
      {"name": "Recharge shift", "where": "chargers", "minutes": [14, 28], "count": 6, "noticed_m": 70, "what": "Robots step out of some stations and others step in; the lights change. Stations that were safe may not be, and the other way round."},
      {"name": "Supply restock", "where": "drops_supply", "minutes": [12, 24, 36], "count": 1, "noticed_m": 400, "what": "A carrier robot sets down a sealed crate on a square, under a tall light. High loot for whoever gets there, and everyone within 400 m sees the light."},
      {"name": "Scav fuel run", "where": "fuel", "minutes": [8, 18, 29, 39], "count": 2, "noticed_m": 350, "what": "A scav crew pulls up at a petrol station with a hand pump and a generator and fills cans: the generator's racket carries 350 m down the big roads. Fuel to take from them, or a crew to keep clear of. (Owner's go-ahead 2026-11-14; times, count and range are defaults.)"},
      {"name": "Town chime", "where": "mast", "minutes": [12, 34], "everywhere": true, "what": "The town's public loudspeakers still play their chime, as every Japanese town does. Each chime is a step up in threat: more robots walk, more stations are manned."},
